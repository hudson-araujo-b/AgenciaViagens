<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Rotta</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AgenciaViagens.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- Oculta a barra de navegação se a propriedade EsconderNavbar estiver ativa -->
    @if (ViewData["EsconderNavbar"] is not true)
    {
        <header>
            <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-2">
                <div class="container-fluid">
                    <!-- Logotipo com link para a listagem principal de passagens -->
                    <a class="navbar-brand" asp-controller="Passagem" asp-action="Index">
                        <img src="~/img/rotta.png" alt="Rotta Viagens Aéreas" class="navbar-logo" />
                    </a>
                    <!-- Botão para alternar a visibilidade do menu em telas móveis -->
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <!-- Links principais de navegação (Compras é visível apenas para usuários logados) -->
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Passagem" asp-action="Index">Passagens</a>
                            </li>
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Compra" asp-action="Index">Compras</a>
                                </li>
                            }
                        </ul>
                        <!-- Ações do usuário: menu de configurações se autenticado, ou botão 'Entrar' para visitantes -->
                        <ul class="navbar-nav align-items-center">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <!-- Menu suspenso com opções de conta e logout para usuário logado -->
                                <li class="nav-item dropdown">
                                    <a class="btn-configuracoes dropdown-toggle" href="#" role="button" id="navbarDropdownUsuario" data-bs-toggle="dropdown" aria-expanded="false">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l-.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l-.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                                        Configurações
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="navbarDropdownUsuario">
                                        <li class="dropdown-header text-truncate" style="max-width: 220px;" title="@User.Identity.Name">
                                            @User.Identity.Name
                                        </li>
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Usuario" asp-action="Configuracoes">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                                Conta
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <a class="dropdown-item text-danger d-flex align-items-center gap-2" asp-controller="Usuario" asp-action="Sair">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                                                Sair
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            }
                            else
                            {
                                if (ViewData["Title"]?.ToString() != "Login" && ViewData["Title"]?.ToString() != "Criar Conta")
                                {
                                    <!-- Botão de acesso para usuários não autenticados -->
                                    <li class="nav-item">
                                        <a class="btn-entrar" asp-controller="Usuario" asp-action="Login">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
                                            Entrar
                                        </a>
                                    </li>
                                }
                            }
                        </ul>
                    </div>
                </div>
            </nav>
        </header>
    }
    
    <!-- Container principal que renderiza a View correspondente -->
    <div class="container flex-grow-1">
        <main role="main" class="pb-1">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted text-center">
        <div class="container py-1">
            &copy; @DateTime.Now.Year - Rotta Viagens Aéreas. Todos os direitos reservados.
        </div>
    </footer>
    
    <!-- Botão flutuante para subir a tela com rolagem suave (controlado por site.js) -->
    <button id="btnScrollTop" class="btn-scroll-top" aria-label="Voltar ao início">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/></svg>
    </button>

    <!-- Importação de scripts base do sistema -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
