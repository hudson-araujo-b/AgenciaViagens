@{
    ViewData["Title"] = "Login Necessário";
}

<div class="pagina-centralizada">
    <div class="card-resultado">
        <div class="resultado-header">
            <div class="resultado-icone resultado-icone-aviso">
                <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
            </div>
            <h1 class="resultado-titulo">Login Necessário</h1>
            <p class="resultado-mensagem">
                Para prosseguir com a compra desta passagem, você precisa estar autenticado na sua conta.
            </p>
        </div>
        <div class="resultado-acoes">
            <a asp-controller="Usuario" asp-action="Login" class="btn btn-primario">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                    <polyline points="10 17 15 12 10 7"></polyline>
                    <line x1="15" y1="12" x2="3" y2="12"></line>
                </svg>
                Fazer Login
            </a>
            <a asp-controller="Usuario" asp-action="CriarConta" class="btn btn-fantasma">
                Criar uma Conta
            </a>
        </div>
        <div class="resultado-voltar-container">
            <a asp-controller="Passagem" asp-action="Index" class="link-voltar">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                Voltar para a listagem
            </a>
        </div>
    </div>
</div>
